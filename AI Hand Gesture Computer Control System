13. Basic Working Code

Create a file named:

main.py

Use:

import cv2
import mediapipe as mp
import pyautogui
import math

screen_width, screen_height = pyautogui.size()

mp_hands = mp.solutions.hands
mp_draw = mp.solutions.drawing_utils

hands = mp_hands.Hands(
    max_num_hands=1,
    min_detection_confidence=0.7,
    min_tracking_confidence=0.7
)

cap = cv2.VideoCapture(0)

click_ready = True

while True:
    success, frame = cap.read()

    if not success:
        break

    frame = cv2.flip(frame, 1)

    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    result = hands.process(rgb)

    if result.multi_hand_landmarks:

        hand = result.multi_hand_landmarks[0]
        landmarks = hand.landmark

        index_x = int(landmarks[8].x * frame.shape[1])
        index_y = int(landmarks[8].y * frame.shape[0])

        thumb_x = int(landmarks[4].x * frame.shape[1])
        thumb_y = int(landmarks[4].y * frame.shape[0])

        middle_x = int(landmarks[12].x * frame.shape[1])
        middle_y = int(landmarks[12].y * frame.shape[0])

        pyautogui.moveTo(
            int(landmarks[8].x * screen_width),
            int(landmarks[8].y * screen_height)
        )

        distance = math.sqrt(
            (index_x - thumb_x) ** 2 +
            (index_y - thumb_y) ** 2
        )

        if distance < 40:

            if click_ready:
                pyautogui.click()
                click_ready = False

            cv2.putText(
                frame,
                "CLICK",
                (50, 80),
                cv2.FONT_HERSHEY_SIMPLEX,
                1,
                (0, 255, 0),
                2
            )

        else:
            click_ready = True

        mp_draw.draw_landmarks(
            frame,
            hand,
            mp_hands.HAND_CONNECTIONS
        )

    cv2.putText(
        frame,
        "AI Hand Gesture Control",
        (30, 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (255, 255, 255),
        2
    )

    cv2.imshow("AI Hand Gesture Computer Control", frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()

This gives you a basic working prototype for webcam hand detection, cursor movement, and pinch-based clicking.

