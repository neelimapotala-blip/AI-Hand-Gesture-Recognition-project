# 15. FastAPI Backend

Create:

```text
backend/main.py
```

```python
from fastapi import FastAPI
from pydantic import BaseModel
import joblib

app = FastAPI()

model = joblib.load(
    "../ml/student_performance_model.pkl"
)

class StudentData(BaseModel):
    attendance: float
    study_hours: float
    assignment_score: float
    internal_marks: float
    previous_score: float
    participation: float

@app.get("/")
def home():
    return {
        "message": "Student Performance AI API"
    }

@app.post("/predict")
def predict(data: StudentData):

    features = [[
        data.attendance,
        data.study_hours,
        data.assignment_score,
        data.internal_marks,
        data.previous_score,
        data.participation
    ]]

    prediction = model.predict(features)[0]

    probabilities = model.predict_proba(features)[0]

    classes = model.classes_

    probability = {
        str(classes[i]): round(
            float(probabilities[i]) * 100, 2
        )
        for i in range(len(classes))
    }

    recommendations = []

    if data.attendance < 75:
        recommendations.append(
            "Improve attendance above 75%."
        )

    if data.study_hours < 2:
        recommendations.append(
            "Increase daily study time."
        )

    if data.assignment_score < 60:
        recommendations.append(
            "Complete assignments regularly."
        )

    if data.internal_marks < 50:
        recommendations.append(
            "Focus more on internal assessment topics."
        )

    if data.previous_score < 50:
        recommendations.append(
            "Practice previous examination questions."
        )

    if not recommendations:
        recommendations.append(
            "Continue your current study routine."
        )

    return {
        "prediction": prediction,
        "probability": probability,
        "recommendations": recommendations
    }
```

